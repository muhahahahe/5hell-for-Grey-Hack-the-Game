Collection = {}
Collection.map = {}
Collection.type = "Collection"

Collection.hasIndex = function(i=0) // Check if the map has the given index
    return self.map.hasIndex(i)
end function

Collection.indexes = function // Return all indexes in the map
    return self.map.indexes
end function

Collection.indexOf = function(x) // Return the index of the given value
    if x == "" then return null
    return self.map.indexOf(x)
end function

Collection.len = function(id=null) // Return the length of the map or specific id
    if id then
        if self.map.hasIndex(id) then return self.map[id].len
    else
        return self.map.len
    end if
end function

Collection.values = function // Return all values in the map
    return self.map.values
end function

Collection.valuesOf = function(x) // Return the values of the given id
    if not x then return null
    if not self.map.hasIndex(x) then return null
    return self.map[x].values
end function

Collection.sum = function(id=null) // Return the sum of values in the map or a specific id
    total = 0
    if id then
        if self.map.hasIndex(id) then
            total = self.map[id].sum
        end if
    else
        for id in self.map
            total = total + self.map[id.key].sum
        end for
    end if
    return total
end function

Collection.set = function(id="", data={}) // Set a key-value pair with id in the map
    if id == "" then return false
    if data.len == 0 then return false
    self.map[id] = data
    return true
end function

Collection.get = function(id="") // Get the collection of the given id
    if id == "" then return null
    if not self.map.hasIndex(id) then return null
    collection = {}
    collection[id] = self.map[id]
    return collection
end function

Collection.remove = function(id="", key=null) // Remove the id or a specific key-value pair from the map
    if id == "" then return 0
    if not self.map.hasIndex(id) then return 0
    if key then
        if not self.map[id].hasIndex(key) then return 0
        return self.map[id].remove(key)
    else
        return self.map.remove(id)
    end if
end function

Collection.find = function(key="", id=null) // Find a value by key in the submaps or a specific sub-map
    if key == "" then return null
    if not id then
        for id in self.map
            if id.value.hasIndex(key) then return id.value[key]
        end for
    else
        if not self.map.hasIndex(id) then return null
        if self.map[id].hasIndex(key) then return self.map[id][key]
    end if
    return null
end function

Collection.filter = function(key="", value=null) // Filter the map by key and optional value
    if key == "" then return null
    if self.map == {} then return null
    collection = {}
    for id in self.map
        if not value then
            if id.value.hasIndex(key) then collection[id.key] = id.value
        else
            if not id.value.hasIndex(key) then continue
            if id.value[key] == value then collection[id.key] = id.value
        end if
    end for
    if collection == {} then return null
    return collection
end function

Collection.clear = function // Clear all entries in the map
    self.map = {}
end function

Collection.merge = function(collection, opt=1) // Merge another collection into this one
    // opt 1: merge overwrite self
    if opt == 1 then
        for id in collection.map
            self.map[id.key] = id.value
        end for
    // opt 2: merge overwrite merger
    else if opt == 2 then
        for id in self.map
            collection.map[id.key] = id.value
        end for
        self.map = collection.map
    // opt 3: merge keep both
    else if opt == 3 then
        for id in collection.map
            if self.map.hasIndex(id.key) then
                self.map[id.key+"_new"] = id.value
            else
                self.map[id.key] = id.value
            end if
        end for
    end if
end function

Collection.clone = function // Create a deep copy of the collection
    newCollection = {}
    for id in self.map
        newCollection[id.key] = self.map[id.key]
    end for
    return newCollection
end function

// Example usage
Collection.set("id1", {"key1": "value1"})
Collection.set("id2", {"key1": "value1", "key2": "value2"})
Collection.set("id3", {"key1": "value1", "key2": "test", "key3": "value3"})
Collection.set("id4", {"key1": "value1", "key3": "value3", "key4": 7})
Collection.set("id5", {"key1": 2, "key2": "test", "key3": "value3", "key4": "value4", "key5": 5})
// Tests
print("Values: "+Collection.values+char(10))
// will blantently overwrite
Collection.set("id1", {"key1": 1, "key2": 2})
print("Sum of id1: "+Collection.sum("id1")+char(10))
print("Get id1: "+Collection.get("id1")+char(10))
print("Find key1: "+Collection.find("key1")+char(10))
print("Filter key2: "+Collection.filter("key2")+char(10))
print("Filter key2 with test: "+Collection.filter("key2", "test")+char(10))
print("Sum of all: "+Collection.sum+char(10))
print("Remove id3: "+Collection.remove("id3")+char(10))
print("Remove key1 from id4: "+Collection.remove("id4", "key1")+char(10))
print("Cant find key2 of id3: "+Collection.find("key2", "id3")+char(10))
print(Collection)