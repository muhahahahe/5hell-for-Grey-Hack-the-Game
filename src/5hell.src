import_code("/src/utils.src")

ShellInterface = {} // most likely imported from another file
CommandManager = {} // imported from another file
DatabaseManager = {} // imported from another file
NetworkManager = {} // imported from another file
FileManager = {} // imported from another file
GameManager = {} // imported from another file

MainInstance = {
	"shellInterface": null,
	"commandManager": null,
	"databaseManager": null,
	"networkManager": null,
	"fileManager": null,
	"gameManager": null,
	"sessions": null,

	//default settings
	"debug": false,
}
MainInstance.init = function(params)
	self.shellInterface = new ShellInterface
	self.commandManager = new CommandManager
	self.databaseManager = new DatabaseManager
	self.networkManager = new NetworkManager
	self.fileManager = new FileManager
	self.gameManager = new GameManager
	self.sessions = new Collection
	if params.hasIndex("--debug") then self.debug = true
end function

// Initialize the main instance
main = new MainInstance
main.init(params)